FROM pgvector/pgvector:pg16

# 1. pg_bigm 소스 빌드에 필요한 컴파일러 및 도구 설치
RUN apt-get update && apt-get install -y \
    build-essential \
    postgresql-server-dev-16 \
    wget \
    pkg-config \
    libicu-dev \
    # 2. pg_bigm 최신 소스코드 다운로드 및 압축 해제
    && wget https://github.com/pgbigm/pg_bigm/archive/refs/tags/v1.2-20240606.tar.gz \
    && tar zxf v1.2-20240606.tar.gz \
    && cd pg_bigm-1.2-20240606 \
    # 3. 확장 프로그램 컴파일 및 PostgreSQL에 설치
    && make USE_PGXS=1 \
    && make USE_PGXS=1 install \
    # 4. 도커 이미지 용량 최적화를 위해 빌드용 도구 및 임시 파일 완전히 삭제
    && cd .. \
    && rm -rf v1.2-20240606.tar.gz pg_bigm-1.2-20240606 \
    && apt-get remove -y build-essential postgresql-server-dev-16 wget pkg-config \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
